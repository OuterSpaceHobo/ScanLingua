{
  "name": "context_ts_react_esbuild",
  "private": true,
  "description": "Take screenshots",
  "version": "0.0.0",
  "manifest_version": 3,
  "type": "module",
  "background": {
    "service_worker": "index.js"
  },
  "permissions": [
    "desktopCapture",
    "downloads",
    "tabs"
  ],
  "action": {
    "default_title": "Take a Screenshot"
  },
  "icons": {
    "16": "/src/icon-16.png",
    "32": "/src/icon-32.png",
    "48": "/src/icon-48.png",
    "100": "/src/icon-100.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "scripts": {
    "build": "esbuild src/content-script.ts --bundle --minify --outfile=./../service_worker/public/content-script.js",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.0.17",
    "@chakra-ui/react": "^2.5.4",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@reduxjs/toolkit": "^1.9.5",
    "@types/chrome": "^0.0.217",
    "@types/react-redux": "^7.1.25",
    "esbuild": "0.17.10",
    "framer-motion": "^10.9.1",
    "is-port-reachable": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-frame-component": "^5.2.6",
    "react-icons": "^4.9.0",
    "react-redux": "^8.0.7",
    "react-transition-group": "^4.4.5",
    "redux": "^4.2.1",
    "styled-components": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.10",
    "@types/styled-components": "^5.1.26",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^4.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  }
}
