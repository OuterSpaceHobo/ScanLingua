{
  "name": "scan-lingua",
  "private": true,
  "description": "scan-lingua service_worker",
  "version": "0.0.1",
  "manifest_version": 3,
  "type": "module",
  "background": {
    "service_worker": "index.js"
  },
  "permissions": [
    "desktopCapture",
    "downloads",
    "tabs"
  ],
  "action": {
    "default_title": "Take a Screenshot"
  },
  "icons": {
    "16": "/assets/icon-16.png",
    "32": "/assets/icon-32.png",
    "48": "/assets/icon-48.png",
    "100": "/assets/icon-100.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script.js"
      ]
    }
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npx esbuild src/ocr/offscreen-entry.ts --bundle --outfile=dist/offscreen.js --format=esm --target=esnext && npx esbuild src/ocr/bridge.ts --bundle --outfile=dist/bridge.js --format=esm --target=esnext --external:chrome && npx esbuild src/translator.ts --bundle --outfile=dist/translator.js --format=esm --target=esnext && npx esbuild src/dictionary.ts --bundle --outfile=dist/dictionary.js --format=esm --target=esnext --external:chrome",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.0.0",
    "@types/chrome": "^0.0.315",
    "html-to-image": "^1.11.11",
    "i18next": "^25.8.18",
    "onnxruntime-web": "^1.24.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-frame-component": "^5.2.6",
    "react-i18next": "^16.5.8",
    "react-redux": "^9.0.0",
    "vite-plugin-css-injected-by-js": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "onnxruntime-node": "^1.24.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
